<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SCADA зрошення</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SCADA зрошення</a>
                <ul class="navbar-nav me-auto flex-grow-1">
                    @* ЛР №9: посилання на сторінки SCADA бачать лише користувачі, що увійшли.
                       Це лише зручність інтерфейсу — доступ до URL перевіряє сервер ([Authorize]). *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Scheme" asp-action="Index">Мнемосхема</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Scheme" asp-action="History">Історія</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Privacy">Конфіденційність</a>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <main class="container-fluid pb-3">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
