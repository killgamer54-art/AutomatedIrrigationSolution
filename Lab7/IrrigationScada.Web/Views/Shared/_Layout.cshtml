<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SCADA зрошення</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SCADA зрошення</a>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Scheme" asp-action="Index">Мнемосхема</a></li>
                </ul>
                <div class="scada-clock">
                    <b id="clock-time">@DateTime.Now.ToString("HH:mm:ss")</b>
                    <small id="clock-date">@DateTime.Now.ToString("dddd, d MMMM yyyy 'р.'",
                        new System.Globalization.CultureInfo("uk-UA"))</small>
                </div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script>
        setInterval(() => {
            const now = new Date();
            document.getElementById('clock-time').textContent =
                now.toLocaleTimeString('uk-UA');
            document.getElementById('clock-date').textContent =
                now.toLocaleDateString('uk-UA',
                    { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        }, 1000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
